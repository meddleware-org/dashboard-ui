{
  "name": "@meddleware/dashboard-ui",
  "version": "0.1.98",
  "homepage": "https://docs.meddleware.co.uk/",
  "description": "The Meddleware dashboard: the treasury, Walrus storage, sealed storage, access gates and token issuance in one place, with one wallet connection for all five tools. Vue 3 single-page app.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/dashboard-ui.git"
  },
  "type": "module",
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "CHANGELOG.md",
    "!src/e2e*.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:e2e": "VITE_E2E=1 vite build --mode e2e",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "licenses": "mw-third-party-licenses",
    "check:licenses": "mw-third-party-licenses --check",
    "check:csp": "mw-check-csp-inline @Dockerfile dist",
    "shots": "SHOTS=1 playwright test",
    "lhci": "npm run build && lhci autorun",
    "check:bundle": "check-prod-bundle dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/access-gate-client": "^0.0.13",
    "@meddleware/access-gate-ui": "^0.1.48",
    "@meddleware/design-tokens": "^0.1.13",
    "@meddleware/sealed-storage-client": "^0.0.26",
    "@meddleware/sealed-storage-ui": "^0.0.48",
    "@meddleware/token-issuance-ui": "^0.0.46",
    "@meddleware/treasury-ui": "^0.0.27",
    "@meddleware/ui": "^0.1.40",
    "@meddleware/wallet-adapter": "^0.0.22",
    "@meddleware/walrus-storage-ui": "^0.1.69",
    "@meddleware/web-utils": "^0.0.4",
    "@mysten/sui": "^2.36.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@meddleware/frontend-config": "^0.0.7",
    "@playwright/test": "~1.64.1",
    "@types/node": "~26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "html-validate": "^11.16.4",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vitest": "~5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "extends @meddleware/frontend-config/browserslist-config"
  ],
  "overrides": {
    "basic-ftp": "^6.2.4",
    "tmp": "^0.2.7",
    "zod": "^4.6.7"
  },
  "meddleware": {
    "kind": "app",
    "csp": "chain-wasm",
    "lhci": true
  }
}
